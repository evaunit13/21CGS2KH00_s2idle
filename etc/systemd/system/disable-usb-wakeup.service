[Unit]
Description=Disable USB controller and AC adapter wakeup to prevent sleep crashes on charger plug
After=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash -c "for dev in XHC0 XHC1 XHC2 XHC3 XHC4 ACDC; do if grep -q \"^$dev.*\\*enabled\" /proc/acpi/wakeup; then echo \"$dev\" > /proc/acpi/wakeup; fi; done"

[Install]
WantedBy=multi-user.target
